# Django Configuration
DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=postgresql://skill_user:skill_pass@localhost:5432/skill_gap_analyzer
DB_ENGINE=django.db.backends.postgresql
DB_NAME=skill_gap_analyzer
DB_USER=skill_user
DB_PASSWORD=skill_pass
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# Hugging Face
HUGGINGFACE_API_KEY=hf_your-api-key-here

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=skill-gap-analyzer
AWS_S3_REGION_NAME=us-east-1

# GitHub API (for project analysis)
GITHUB_TOKEN=ghp_your-github-token

# Frontend
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENV=development

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
